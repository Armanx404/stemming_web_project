PORT=5000
NODE_ENV=development
API_PREFIX=/api

MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

JWT_SECRET=<generate-a-64-byte-hex-secret>
JWT_REFRESH_SECRET=<generate-a-different-64-byte-hex-secret>
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_COOKIE_MAX_AGE_MS=2592000000

MIN_PASSWORD_LENGTH=6

REDIS_URL=redis://localhost:6379
REDIS_TLS=false
REDIS_CACHE_TTL_SECONDS=300

R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<cloudflare-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<cloudflare-r2-secret-access-key>
STORAGE_BUCKET_NAME=<cloudflare-r2-bucket-name>
R2_PUBLIC_DOMAIN=https://<your-r2-public-domain>
R2_SIGNED_URL_TTL_SECONDS=14400

MAX_FILE_SIZE_MB=500
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=50
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
